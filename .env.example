# Backend (copy to backend/.env). For local development use the compose database:
# DATABASE_URL=postgresql+psycopg://kjbn:kjbn_local_only@localhost:5432/kjbn_dev
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated UI origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
# Let reviewers override "today" with the X-Test-Clock header
ALLOW_TEST_CLOCK=true
# Tests only: must be a database whose name ends in _test (it is wiped on every run)
TEST_DATABASE_URL=postgresql+psycopg://kjbn:kjbn_local_only@localhost:5432/kjbn_test

# Frontend (used when the React app is created)
VITE_API_BASE_URL=http://localhost:8001
